{
  "name": "ai-image-studio-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 execute typix-db --file=./drizzle/migrations/0000_initial.sql",
    "db:migrate:local": "wrangler d1 execute typix-db --local --file=./drizzle/migrations/0000_initial.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.0",
    "jose": "^5.10.0",
    "nanoid": "^5.1.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "~5.8.3",
    "wrangler": "^4.14.0"
  }
}
