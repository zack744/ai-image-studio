{
	"name": "typix",
	"private": true,
	"version": "1.0.9",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"analyze": "vite build --mode analyze",
		"fmt": "biome format --write .",
		"lint": "biome lint .",
		"preview": "vite preview",
		"deploy:worker": "wrangler deploy --config worker/wrangler.toml --env production",
		"deploy:worker:dev": "wrangler deploy --config worker/wrangler.toml",
		"deploy:frontend": "tsc -b && vite build && wrangler pages deploy dist --project-name typix-frontend",
		"db:migrate": "wrangler d1 execute typix-db --config worker/wrangler.toml --remote --file"
	},
	"dependencies": {
		"@bprogress/core": "^1.3.4",
		"@fal-ai/client": "^1.6.1",
		"@google/genai": "^1.15.0",
		"@hookform/resolvers": "^5.1.1",
		"@lobehub/icons": "^2.9.0",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.15",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-scroll-area": "^1.2.9",
		"@radix-ui/react-select": "^2.2.5",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@tailwindcss/vite": "^4.1.7",
		"@tanstack/react-router": "^1.120.10",
		"@tanstack/react-router-devtools": "^1.120.10",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "^25.2.1",
		"i18next-browser-languagedetector": "^8.1.0",
		"input-otp": "^1.4.2",
		"jszip": "^3.10.1",
		"lucide-react": "^0.511.0",
		"motion": "^12.17.0",
		"nanoid": "^5.1.5",
		"next-themes": "^0.4.6",
		"openai": "^5.9.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.59.0",
		"react-i18next": "^15.5.2",
		"sonner": "^2.0.3",
		"swr": "^2.3.3",
		"tailwind-merge": "^3.3.0",
		"tailwindcss": "^4.1.7",
		"yet-another-react-lightbox": "^3.24.0",
		"zod": "^3.25.67",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tanstack/router-plugin": "^1.120.10",
		"@types/node": "^22.15.21",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react-swc": "^3.9.0",
		"globals": "^16.0.0",
		"tsup": "^8.5.0",
		"tw-animate-css": "^1.3.0",
		"typescript": "~5.8.3",
		"vite": "^6.3.5",
		"vite-bundle-analyzer": "^1.1.0"
	}
}
